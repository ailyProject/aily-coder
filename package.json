{
  "name": "@aily-project/subapp-aily-coder",
  "version": "0.1.2",
  "type": "module",
  "main": "index.js",
  "hide": true,
  "files": [
    "ui",
    "!ui/**/*.map",
    "i18n",
    "agent",
    "skill/aily-coder-library",
    "runtime",
    "server/componentLibraryApi.d.ts",
    "index.js",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "aily": {
    "uiIndex": "ui/index.html"
  },
  "ailySubapp": {
    "id": "aily-coder",
    "package": "@aily-project/subapp-aily-coder",
    "namespace": "AILY_CODER",
    "titleKey": "AILY_CODER.TITLE",
    "app": {
      "icon": "fa-light fa-code",
      "enabled": true,
      "extension": true
    },
    "runtime": {
      "startupTimeoutMs": 30000
    },
    "agent": {
      "protocolVersion": 1,
      "availability": {
        "developmentModes": [
          "coder"
        ]
      },
      "skills": [
        "skill/aily-coder-library/SKILL.md"
      ],
      "tools": {
        "transport": "aily-child-rpc",
        "manifest": "agent/tools.json"
      }
    }
  },
  "scripts": {
    "update-local-dependencies": "tsx update-local-dependencies.ts",
    "clean": "tsc -b -c",
    "start": "vite --config vite.config.ts",
    "start:debug": "vite --config vite.config.ts --debug --force",
    "dev": "node scripts/link-dev.mjs --watch",
    "lint": "eslint src server vite.config.ts vite.netlify.config.ts update-local-dependencies.ts",
    "typecheck": "tsc --noEmit",
    "check-build": "npm run lint && npm run typecheck",
    "build": "npm run check-build && npm run build:runtime && vite --config vite.config.ts build",
    "build:runtime": "node scripts/build-runtime.mjs",
    "build:watch": "vite --config vite.config.ts build --watch",
    "build:subapp": "npm run build",
    "build:netlify": "npm run check-build && vite --config vite.netlify.config.ts build",
    "dev:link": "node scripts/link-dev.mjs",
    "dev:unlink": "node scripts/link-dev.mjs --unlink",
    "test:link-dev": "npm run build:subapp && node --test scripts/link-dev.test.mjs",
    "test:package-runtime": "npm run build:runtime && node --test scripts/package-runtime.test.mjs",
    "test:component-libraries": "node --test server/componentLibraryService.test.js server/agentRpcRouter.test.js server/agentRpcServer.test.js",
    "test:aily-view-library": "tsx --test src/features/ailyLibraryProjection.test.ts",
    "test:inline-completion": "tsx --test src/features/aiInlineCompletionTransport.test.ts src/features/aiInlineCompletionCloudTransport.test.ts",
    "prepack": "npm run build:subapp",
    "start:debugServer": "tsx src/debugServer.ts",
    "lsp-proxy": "tsx server/lspWsProxy.ts"
  },
  "overrides": {
